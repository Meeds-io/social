<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>social-component</artifactId>
    <groupId>io.meeds.social</groupId>
    <version>7.1.x-SNAPSHOT</version>
  </parent>
  <artifactId>social-component-service</artifactId>
  <name>Meeds:: PLF:: Social Service Component</name>
  <description>Meeds Social Service Component</description>
  <properties>
    <exo.test.coverage.ratio>0.52</exo.test.coverage.ratio>

    <rest.api.doc.title>Social Rest Api</rest.api.doc.title>
    <rest.api.doc.version>1.0</rest.api.doc.version>
    <rest.api.doc.description>All used social rest endpoints</rest.api.doc.description>
  </properties>
  <dependencies>
    <!-- These dependency is required to compile but reported as useless by mvn dependency:analyze -->
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-common</artifactId>
    </dependency>
    <!-- These dependency is required to compile but reported as useless by mvn dependency:analyze -->
    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-core</artifactId>
    </dependency>

    <dependency>
      <groupId>io.meeds.social</groupId>
      <artifactId>social-component-core</artifactId>
      <type>test-jar</type>
    </dependency>

  </dependencies>
  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <configuration>
          <aspectLibraries>
            <aspectLibrary>
              <groupId>io.meeds.portal</groupId>
              <artifactId>portal.component.common</artifactId>
            </aspectLibrary>
            <aspectLibrary>
              <groupId>${project.groupId}</groupId>
              <artifactId>social-component-api</artifactId>
            </aspectLibrary>
          </aspectLibraries>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/InitContainerTestSuite.java</include>
            <include>**/NoContainerTestSuite.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin</artifactId>
        <configuration>
          <outputFileName>social-javax</outputFileName>
          <outputPath>${project.build.directory}/swagger</outputPath>
          <outputFormat>YAML</outputFormat>
          <resourcePackages>
            <package>io.meeds.social</package>
            <package>org.exoplatform.social.rest.impl</package>
          </resourcePackages>
          <prettyPrint>TRUE</prettyPrint>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.github.kbuntrock</groupId>
        <artifactId>openapi-maven-plugin</artifactId>
        <configuration>
          <outputDirectory>${project.build.directory}/swagger</outputDirectory>
          <apis>
            <api>
              <filename>social-spring.yaml</filename>
              <locations>
                <location>io.meeds.social.category</location>
                <location>io.meeds.social.cms</location>
                <location>io.meeds.social.coediting</location>
                <!-- do not analyze databind as the plugin does not support a parameter in the service -->
                <!--location>io.meeds.social.databind</location-->
                <location>io.meeds.social.navigation</location>
                <location>io.meeds.social.observer</location>
                <location>io.meeds.social.resource</location>
                <location>io.meeds.social.rest.impl</location>
                <location>io.meeds.social.security</location>
                <location>io.meeds.social.space</location>
                <location>io.meeds.social.translation</location>
                <location>org.exoplatform.social.rest.impl</location>
              </locations>
            </api>
          </apis>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.rameshkp</groupId>
        <artifactId>openapi-merger-maven-plugin</artifactId>
        <configuration>
          <inputDir>${project.build.directory}/swagger</inputDir>
          <outputDir>${project.build.directory}/</outputDir>
          <outputFileFormat>YAML</outputFileFormat>
          <outputFileName>social</outputFileName>
          <openApi>
            <version>3.0.3</version>
            <info>
              <title>${rest.api.doc.title}</title>
              <version>${rest.api.doc.version}</version>
              <description>${rest.api.doc.description}</description>
              <license>
                <url>https://www.gnu.org/licenses/lgpl-3.0.en.html</url>
                <name>LGPL</name>
              </license>
            </info>
          </openApi>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
