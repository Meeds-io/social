<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;" class="mail-surface mail-text">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.ActivityCommentPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                            <tr>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 20px 0 10px;" class="mail-surface">
                                    <p style="margin: 0 0 10px; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text};" class="mail-text"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin: 10px 0 20px; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text};" class="mail-text">
                                    <%
                                      String profileUrl = "<strong><a target=\"_blank\" style=\"color: ${palette.link}; font-size: 13px; text-decoration: none; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif\" href=\""+ PROFILE_URL + "\" class=\"mail-link\">" + _ctx.escapeHTML(USER) + "</a></strong>";
                                    %>
                                    <%=_ctx.appRes("Notification.message.ActivityCommentPlugin", profileUrl)%> :
                                    </p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                                        <tbody>
                                            <tr>
                                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.background}; padding: 15px 20px;" class="mail-bg">
                                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
																											<tbody>
																												<tr>
																													<td align="left" bgcolor="${palette.background}" style="background-color: ${palette.background}; padding: 0x; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text};" class="mail-bg mail-text">$ACTIVITY</td>
																												</tr>
																												<tr>
																													<td align="left" bgcolor="${palette.background}" style="
																														background-color: ${palette.background};
																														line-height: 16px;
																														font-family: HelveticaNeue, Helvetica, Arial, sans-serif;
																														color: ${palette.text};
																														padding: 6px 0 6px;
																													" class="mail-bg mail-text">
																														<hr style="
																															border-width: 1px 0 0;
																															border-style: solid none none;
																															border-color: ${palette.border} transparent transparent;
																															margin: 6px 0;
																															padding: 0;
																														" class="mail-border">
																													</td>
																												</tr>
																												<tr>
																													<td align="left" bgcolor="${palette.background}" style="
																														background-color:${palette.background};
																														padding:0 0 1px;
																														line-height:16px;
																														font-family:HelveticaNeue,Helvetica,Arial,sans-serif;
																														color:${palette.text}" class="mail-bg mail-text">
																														<p style="margin: 0 0 5px;line-height:16px;font-family:HelveticaNeue,Helvetica,Arial,sans-serif;color:${palette.text}" class="mail-text">
																															<%=profileUrl%><strong style="color: ${palette.link}; font-size: 13px;" class="mail-link">:</strong>
																														</p>
                                                            $COMMENT
																													</td>
																												</tr>
																											</tbody>
																										</table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <br/>
                                    <p style="margin: 0 0 20px;">
                                        <% if (OPEN_URL != null) { %>
                                            <a target="_blank" style="
                                                display: inline-block;
                                                text-decoration: none;
                                                font-size: 11px;
                                                font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif;
                                                color: #ffffff;
                                                background-color: ${palette.primary};
                                                background-repeat: repeat-x;
                                                border-radius: 4px;
                                                -moz-border-radius: 4px;
                                                padding: 5px 8px;
                                                height: 11px;
                                                line-height: 11px;
                                                max-height: 11px;
                                                text-align: center;
                                                border: 1px solid ${palette.primary};
                                                font-weight: bold;
                                                -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                vertical-align: middle;
                                                " href="$OPEN_URL" title=<%=_ctx.appRes("Notification.label.Open.Title")%>""><%=_ctx.appRes("Notification.label.Open")%></a>
                                            <% } %>
                                        <a target="_blank" style="
                                            display: inline-block;
                                            text-decoration: none;
                                            font-size: 11px;
                                            font-family: HelveticaNeue, Helvetica, Arial, sans-serif,serif;
                                            color: ${palette.text};
                                            background-color: ${palette.background};
                                            background-repeat: repeat-x;
                                            border-radius: 4px;
                                            -moz-border-radius: 4px;
                                            padding: 5px 8px;
                                            height: 11px;
                                            line-height: 12px;
                                            max-height: 11px;
                                            text-align: center;
                                            border: 1px solid ${palette.border};
                                            -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            vertical-align: middle;
                                            margin-left: 3px;
                                        " href="$REPLY_ACTION_URL" class="mail-text mail-bg mail-border"><%=_ctx.appRes("Notification.label.Reply")%></a>
                                        <a target="_blank" style="
                                            display: inline-block;
                                            text-decoration: none;
                                            font-size: 11px;
                                            font-family: HelveticaNeue, Helvetica, Arial, sans-serif,serif;
                                            color: ${palette.text};
                                            background-color: ${palette.background};
                                            background-repeat: repeat-x;
                                            border-radius: 4px;
                                            -moz-border-radius: 4px;
                                            padding: 5px 8px;
                                            height: 11px;
                                            line-height: 12px;
                                            max-height: 11px;
                                            text-align: center;
                                            border: 1px solid ${palette.border};
                                            -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                            vertical-align: middle;
                                            margin-left: 3px;
                                        " href="$VIEW_FULL_DISCUSSION_ACTION_URL" target="_blank" class="mail-text mail-bg mail-border"><%=_ctx.appRes("Notification.label.ViewFullDiscussion")%></a>
                                    </p>
                                    <p style="margin: 10px 0; color: ${palette.secondaryText}" class="mail-secondary-text">
                                        <%=_ctx.appRes("Notification.label.footer", FOOTER_LINK).replace("color: #2f5e92;", "color: ${palette.link};").replace("<a ", "<a class=\"mail-link\" ")%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>            
            
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
