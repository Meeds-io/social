<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.SharedActivitySpaceStreamPlugin", _ctx.escapeHTML(SPACE)));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin:0; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                        <%
                                          String titleShared = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}\" href=\""+ VIEW_FULL_DISCUSSION_ACTION_URL + "\">" + _ctx.escapeHTML(SHORT_TITLE) + "</a>"
                                          String profileUrl = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}\" href=\""+ PROFILE_URL + "\">" + _ctx.escapeHTML(USER) + "</a>";
                                          String spaceUrl = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}\" href=\""+ SPACE_URL + "\">" + _ctx.escapeHTML(SPACE) + "</a>";
                                        %>
                                    <%=_ctx.appRes("Notification.message.SharedActivitySpaceStreamPlugin", profileUrl, titleShared, spaceUrl)%>:
                                    </p>

                                    <%=io.meeds.portal.mail.EmailLayout.quoteStart(false, _ctx.language)%><%= profileUrl %><%=io.meeds.portal.mail.EmailLayout.quoteEnd()%>
                                    <div dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                        <% if (OPEN_URL != null) { %>
                                            <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.label.Open"), "$OPEN_URL", true)%>
                                            <% } %>
                                        <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.label.Reply"), "$REPLY_ACTION_URL", false)%>
                                        <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.label.ViewFullDiscussion"), "$VIEW_FULL_DISCUSSION_ACTION_URL", false)%>
                                    </div>
                                    <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}">
                                        <%=io.meeds.portal.mail.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footerSettings", FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
