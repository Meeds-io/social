<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height:20px; font-family: HelveticaNeue,Helvetica, Arial, sans-serif" class="mail-surface mail-text">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.RelationshipReceivedRequestPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
        <tr>
            <td>
                <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                    <tr>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; color:${palette.text};line-height:20px;" class="mail-surface mail-text">
                                <tr>
                                    <td align="left" style="padding: 10px 0;">
                                        <p style="margin: 10px 0 5px;font-size:13px; color: ${palette.text}; font-family:'HelveticaNeue bold', Arial, sans-serif" class="mail-text"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                        <table border="0" cellpadding="0" cellspacing="0" bgcolor="${palette.surface}" style="background: ${palette.surface};"  class="mail-surface">
                                            <tr>
                                                <!--[if mso]>
                                                <td valign="top" width="90" bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                                                    <img class="mail-border" width="70" height="70" border="1" style="margin-top: 5px;border-radius: 4px;border: 1px solid ${palette.border};" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                                </td>
                                                <![endif]-->
                                                <td valign="top" width="90px" bgcolor="${palette.surface}" style="background: ${palette.surface}; mso-hide:all;" class="mail-surface">
                                                    <img class="mail-border" width="70px" height="70px" style="margin-top: 5px;border-radius: 4px;border: 1px solid ${palette.border};" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                                </td>
                                                <td  valign="top" bgcolor="${palette.surface}" style="background: ${palette.surface};" class="mail-surface">
                                                    <p style="margin:0 0 10px 0;line-height: 20px; color: ${palette.text}; font-size:13px;font-family:'HelveticaNeue bold',Arial,sans-serif" class="mail-text">
                                                         <%
                                                           String profileUrl = "<a target=\"_blank\" style=\"color: ${palette.link}; text-decoration: none;font-weight:bold;font-family:'HelveticaNeue bold', Arial, sans-serif\" href=\""+ PROFILE_URL + "\" class=\"mail-link\">" + _ctx.escapeHTML(USER) + "</a> ";
                                                         %>
                                                         <%=_ctx.appRes("Notification.message.RelationshipReceivedRequestPlugin", profileUrl)%>
                                                    </p>
                                                    <div>
                                                        <a target="_blank" style="
                                                            display: inline-block;
                                                            text-decoration: none;
                                                            font-size: 11px;
                                                            font-family:HelveticaNeue,arial,tahoma,serif;
                                                            color: #ffffff;
                                                            text-shadow: 0 -1px 0 rgba(23, 33, 37, .25);
                                                            background-color: ${palette.primary};
                                                            background-repeat: repeat-x;
                                                            border-radius: 4px;
                                                            -moz-border-radius: 4px;
                                                            padding: 5px 8px;
                                                            line-height: 100%;
                                                            text-align: center;
                                                            border: 1px solid ${palette.primary};
                                                            font-weight: bold;
                                                            -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            vertical-align: middle;
                                                        " href="$ACCEPT_CONNECTION_REQUEST_ACTION_URL"><%=_ctx.appRes("Notification.label.Accept")%></a>
                                                        <a target="_blank" style="
                                                            display: inline-block;
                                                            text-decoration: none;
                                                            font-size: 11px;
                                                            font-family:HelveticaNeue,arial,tahoma,serif;
                                                            color: ${palette.text};
                                                            background-color: ${palette.background};
                                                            background-repeat: repeat-x;
                                                            border-radius: 4px;
                                                            -moz-border-radius: 4px;
                                                            padding: 5px 8px;
                                                            line-height: 100%;
                                                            text-align: center;
                                                            border: 1px solid ${palette.border};
                                                            -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                            vertical-align: middle;
                                                            margin-left: 3px;
                                                        " href="$REFUSE_CONNECTION_REQUEST_ACTION_URL" target="_blank" class="mail-text mail-bg mail-border"><%=_ctx.appRes("Notification.label.Refuse")%></a>
                                                    </div>                                                  
                                                </td>
                                            </tr>
                                        </table>
                                        
                                        <p style="margin:30px 0 10px 0; color: ${palette.secondaryText};font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif" class="mail-secondary-text">
                                            <%=_ctx.appRes("Notification.label.footer", FOOTER_LINK).replace("color: #2f5e92;", "color: ${palette.link};").replace("<a ", "<a class=\"mail-link\" ")%>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>            
                
            </td>
        </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
    </table>