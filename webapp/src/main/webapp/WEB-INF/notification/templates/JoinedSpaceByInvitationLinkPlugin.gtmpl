<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<%
/*
 This file is part of the Meeds project (https://meeds.io/).

 Copyright (C) 2026 Meeds Association contact@meeds.io

 This program is free software; you can redistribute it and/or
 modify it under the terms of the GNU Lesser General Public
 License as published by the Free Software Foundation; either
 version 3 of the License, or (at your option) any later version.
 This program is distributed in the hope that it will be useful,
 but WITHOUT ANY WARRANTY; without even the implied warranty of
 MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
 Lesser General Public License for more details.

 You should have received a copy of the GNU Lesser General Public License
 along with this program; if not, write to the Free Software Foundation,
 Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
*/
%>
<style>
    a{
        color: ${palette.link};
        text-decoration: none;
        font-family: 'HelveticaNeue Bold', Helvetica, Arial, HelveticaNeue, sans-serif, serif, tahoma;
    }
</style>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;" class="mail-surface mail-text">
    <%
    _templateContext.put("header_title", _ctx.appRes("Notification.subject.JoinedSpaceByInvitationLinkPlugin"));
    _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                            <tr>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 20px 0 10px;" class="mail-surface">
                                    <p style="margin: 0 0 10px; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
                                        <%=_ctx.appRes("Notification.label.SayHello")%> $FIRSTNAME,
                                    </p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                                        <tbody>
                                        <tr>
                                            <td align="left" style="padding: 0;">
                                                <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="width: 100%; background-color: ${palette.surface}; font-size: 13px; color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                                                    <tr>
                                                        <td align="left" valign="top" bgcolor="${palette.surface}" style="vertical-align: top; background-color: ${palette.surface}; padding: 0 15px 0 0;" class="mail-surface">
                                                            <a href="#" style="margin: 4px 0 0; padding: 0; display: block;">
                                                                <img style="border-radius: 4px;" height="76" width="76" src="$AVATAR" alt="$USER" />
                                                            </a>
                                                        </td>
                                                        <td align="left" bgcolor="${palette.surface}" width="90%" align="top" style="width: 90%; background-color: ${palette.surface}; padding: 0 0; vertical-align: top;" class="mail-surface">
                                                            <p style="margin: 0 0 10px; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
                                                                <%
                                                                msg = _ctx.appRes("Notification.mail.message.JoinedSpaceByInvitationLinkPlugin","<b>" + INVITED_USER_DISPLAY_NAME + "</b>", "<b>" + SPACE_DISPLAY_NAME + "</b>");
                                                                %>
                                                                <%=msg%>
                                                            </p>

                                                            <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.background}" align="center" style="margin:0 0 10px; width: 100%; background-color: ${palette.background}; font-size: 13px; color:${palette.text};line-height: 18px;" class="mail-bg mail-text">
                                                                <tr>

                                                                    <td align="left" valign="top" bgcolor="${palette.surface}" style="vertical-align: top; background-color: ${palette.surface}; padding: 10px 0 0" class="mail-surface">
                                                                        <p style="margin: 0">
                                                                            <a target="_blank" style="
                                                                                display: inline-block;
                                                                                font-size: 11px;
                                                                                color: ${palette.text};
                                                                                background-color: ${palette.background};
                                                                                background-repeat: repeat-x;
                                                                                border-radius: 4px;
                                                                                -moz-border-radius: 4px;
                                                                                padding: 5px 8px;
                                                                                line-height: 100%;
                                                                                text-align: center;
                                                                                border: 1px solid ${palette.border};
                                                                                -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                                -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                                box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                                vertical-align: middle;
                                                                                margin-left: 3px;
                                                                                " href="$SPACE_MEMBERS_URL" target="_blank" class="mail-text mail-bg mail-border"><%=_ctx.appRes("Notification.JoinedSpaceByInvitationLinkPlugin.viewMembers")%></a>
                                                                        </p>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                    <br>
                                    <p style="margin: 0 0 10px; color: ${palette.secondaryText}; font-size: 13px; line-height: 18px;" class="mail-secondary-text">
                                        <%=_ctx.appRes("Notification.label.footer", "" + FOOTER_LINK).replace("color: #2f5e92;", "color: ${palette.link};").replace("<a ", "<a class=\"mail-link\" ")%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
