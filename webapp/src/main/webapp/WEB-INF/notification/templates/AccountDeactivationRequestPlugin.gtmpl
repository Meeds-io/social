<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<div style="margin: 20px; background: ${palette.background};color: ${palette.text};font-family:HelveticaNeue,arial,tahoma,serif;" class="mail-bg mail-text">
	<div style="line-height:45px;min-height:45px; border: solid 1px ${palette.border}; border-bottom:none;;font-weight:bold;vertical-align:middle;background-color:${palette.background};color:${palette.link};font-size:18px;text-align:center" class="mail-border mail-bg mail-link">
		<% _ctx.include("war:/notification/templates/mail/NotificationLogo.gtmpl", _templateContext); %>
		<span><%=_ctx.appRes("Notification.title.AccountDeactivationRequestPlugin", USER)%></span>
	</div>
	<div style="border:solid 1px ${palette.border}; padding:20px;border-bottom:none;" class="mail-border">
		<%=_ctx.appRes("Notification.label.AccountDeactivationRequestPlugin.sayHello")%> $FIRSTNAME,<br/>
		<br/>
		<%=_ctx.appRes("Notification.message.AccountDeactivationRequestPlugin", "<b>" + USER + "</b>")%><br/>
		<br/>
		<%=_ctx.appRes("Notification.label.AccountDeactivationRequestPlugin.loggedOut")%><br/>
		<br/>
		<%=_ctx.appRes("Notification.label.AccountDeactivationRequestPlugin.reactivate")%><br/>
		<br/>
		<a target="_blank" href="$USERS_MANAGEMENT_URL"><%=_ctx.appRes("Notification.label.AccountDeactivationRequestPlugin.seeMore")%></a>
		<br/><br/>
		<%=_ctx.appRes("Notification.label.AccountDeactivationRequestPlugin.thanks")%>
		<br/><br/>
		<div style="line-height:20px;color:${palette.secondaryText}" class="mail-secondary-text"><%=_ctx.appRes("Notification.label.footer", FOOTER_LINK).replace("color: #2f5e92;", "color: ${palette.link};").replace("<a ", "<a class=\"mail-link\" ")%></div>
	</div>
	<div style="border:1px solid ${palette.primary};font-size:14px;line-height:40px;min-height:40px; color:#fff;vertical-align:middle;background:${palette.primary};text-align:center;font-weight:bold;">
		<%=_ctx.appRes("Notification.label.CompanyName")%>
	</div>
</div>
