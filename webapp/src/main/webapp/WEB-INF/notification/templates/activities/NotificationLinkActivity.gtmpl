<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="100%"
  bgcolor="${palette.surface}" align="center"
  style="background-color: ${palette.surface}; font-size: 13px; color: ${palette.text}; line-height: 18px;" class="mail-surface mail-text">
  <tbody>
    <tr>
      <td align="left" bgcolor="${palette.background}"
        style="background-color: ${palette.background}; padding: 15px 0;" class="mail-bg">
        <table border="0" cellpadding="0" cellspacing="0" width="100%"
          bgcolor="${palette.surface}" align="center"
          style="background-color: ${palette.surface}; font-size: 13px; color: ${palette.text}; line-height: 18px;" class="mail-surface mail-text">
          <tbody>
            <tr>
              <td align="left" bgcolor="${palette.background}" style="background-color: ${palette.background}; padding: 0 20px 4px; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text};" class="mail-bg mail-text">
                $ACTIVITY_TITLE
              </td>
            </tr>
            <tr>
              <td align="left" bgcolor="${palette.background}" style="background-color: ${palette.background}; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text}; padding: 5px 0;" class="mail-bg mail-text">
                <hr style="border-width: 1px 0 0; border-style: solid none none; border-color: ${palette.border} transparent transparent; margin: 6px 0; padding: 0;" class="mail-border">
              </td>
            </tr>
            <tr>
              <td align="left" bgcolor="${palette.background}"
                style="background-color: ${palette.background}; padding: 0 20px 1px; line-height: 16px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; color: ${palette.text};" class="mail-bg mail-text">
                <table border="0" cellpadding="0" cellspacing="0" width="100%"
                  bgcolor="${palette.surface}" align="center"
                  style="width: 100%; background-color: ${palette.surface}; font-size: 13px; color: ${palette.text}; line-height: 18px;" class="mail-surface mail-text">
                  <tr>
                  <%
                    if (THUMBNAIL_URL != null && THUMBNAIL_URL.length() > 0) {
                  %>
                    <td align="left" valign="top" bgcolor="${palette.background}" style="vertical-align: top; background-color: ${palette.background}; padding: 0 15px 0 0;" class="mail-bg">
                      <a href="$ACTIVITY_URL" style="display: block; position: relative; margin: 0; padding: 0; display: block; margin-top: 5px;">
                        <img style="max-width: 75px;" src="$THUMBNAIL_URL" alt="image" />
                        <%
                          if (IS_EMBED_LINK) {
                        %>
                          <a href="$ACTIVITY_URL" style="white-space: nowrap; font-size: 13px; line-height: 20px; font-family: HelveticaNeue, Helvetica, Arial, sans-serif; text-decoration: none; color: ${palette.link};"  class="mail-link">
                            <span style="
                              display: inline-block;
                              vertical-align: 0px;
                              border-top: 5px solid transparent;
                              border-bottom: 5px solid transparent;
                              border-left: 5px solid ${palette.primary}; margin-right: 2px;
                              
                            "></span>
                            <%=_ctx.appRes("LinkActivity.notification.label.WatchTheVideo")%>
                          </a>
                        <% } %>
                      </a>
                    </td>
                  <%
                    }
                  %>
                    <td align="left" bgcolor="${palette.background}" width="90%" align="top"
                      style="width: 90%; background-color: ${palette.background}; padding: 0 0; vertical-align: top;" class="mail-bg">
                      <a href="$LINK_URL" style="display: inline-block; color: ${palette.link}; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif; font-size: 13px; line-height: 18px; font-weight: bold; text-decoration: none; margin: 0 0 10px;" class="mail-link">
                        $LINK_TITLE
                      </a>
                      <%
                        if (LINK_DESCRIPTION != null && LINK_DESCRIPTION.length() > 0) {
                      %>
                        <p style="margin: 0 0 15px; min-height: 36px;">$LINK_DESCRIPTION</p>
                      <%
                        }
                      %>
                      <p style="margin: 0; color: ${palette.text};" class="mail-text">
                        <%=_ctx.appRes("LinkActivity.notification.label.source")%>: <a style="color: ${palette.link}; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif; font-size: 13px; line-height: 18px; text-decoration: none; max-width: 205px; word-wrap: break-word;"
                          href="$LINK_URL" target="" class="mail-link">$LINK_URL</a>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>
