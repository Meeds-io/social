<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.NewUserPlugin", PORTAL_NAME));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
        <tr>
            <td style="padding:0 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                    <tr>
                        <td>
                            <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                                <tr>
                                    <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" style="padding: 30px 0 10px 0;">
                                        <p style="margin: 0 0 14px;font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                        <table border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="background: #ffffff;" >
                                            <tr>
                                                <!--[if mso]>
                                                <td width="64" valign="top" bgcolor="#ffffff" style="background-color: #ffffff; ">
                                                    <img width="44" height="44" style="margin-top: 2px;border-radius: 50%;" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                                </td>
                                                <![endif]-->
                                                <td width="64" valign="top" bgcolor="#ffffff" style="background: #ffffff; mso-hide:all; ">
                                                    <img width="44" height="44" style="margin-top: 2px;border-radius: 50%;" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                                </td>
                                                <td  valign="top" bgcolor="#ffffff" style="background: #ffffff;" dir="auto">
                                                    <p style="margin:0 0 10px 0;line-height: 1.7; color: #1d2327; font-size: 15px;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}" dir="auto">
                                                         <%
                                                           String profileUrl = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none;font-weight:bold;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}\" href=\""+ PROFILE_URL + "\">" + _ctx.escapeHTML(USER) + "</a> ";
                                                         %>
                                                         <%=_ctx.appRes("Notification.message.NewUserPlugin", profileUrl, PORTAL_NAME)%>
                                                    </p>
                                                                                                      
                                                </td>
                                            </tr>
                                        </table>
<div dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                                        <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.label.ConnectNow"), "$CONNECT_ACTION_URL", true)%>
                                                    </div>
                                        
                                        <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()}">
                                            <%=io.meeds.portal.mail.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footerSettings", FOOTER_LINK))%>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>            
                
            </td>
        </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
    </table>