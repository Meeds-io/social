{
  "from": "@offset@",
  "size": "@limit@",
  "_source": {
    "excludes": ["content", "content-*"]
  },
  "query": {
    "bool": {
      "should": [
        {
          "constant_score": {
            "filter": {
              "query_string": {
                "fields": ["pageTitle", "pageName"],
                "default_operator": "AND",
                "query": "@term@"
              }
            },
            "boost": 10000
          }
        },
        {
          "constant_score": {
            "filter": {
              "query_string": {
                "fields": ["content", "content-*"],
                "default_operator": "AND",
                "query": "@term@"
              }
            },
            "boost": 1000
          }
        },
        {
          "query_string": {
            "fields": ["pageTitle", "pageName", "siteName", "content", "content-*"],
            "default_operator": "AND",
            "query": "@term@"
          }
        }
      ],
      "minimum_should_match": 1,
      "filter": [
        "@filters@"
      ]
    }
  },
  "highlight": {
    "number_of_fragments": 2,
    "fragment_size": 150,
    "no_match_size": 0,
    "order": "score",
    "fields": {
      "pageTitle": {
        "number_of_fragments": 0
      },
      "pageName": {
        "number_of_fragments": 0
      },
      "content": {
        "pre_tags": ["<span class='searchMatchExcerpt'>"],
        "post_tags": ["</span>"]
      },
      "content-*": {
        "pre_tags": ["<span class='searchMatchExcerpt'>"],
        "post_tags": ["</span>"]
      }
    }
  }
}
