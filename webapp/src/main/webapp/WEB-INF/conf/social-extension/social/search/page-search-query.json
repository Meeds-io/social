{
  "from": "@offset@",
  "size": "@limit@",
  "_source": {
    "excludes": ["content", "content-*"]
  },
  "query": {
    "bool": {
      "must": {
        "query_string": {
          "fields": ["pageTitle", "pageName", "siteName", "content", "content-*"],
          "default_operator": "AND",
          "query": "@term@"
        }
      },
      "filter": [
        "@filters@"
      ]
    }
  },
  "highlight": {
    "number_of_fragments": 2,
    "fragment_size": 150,
    "no_match_size": 0,
    "order": "score",
    "fields": {
      "content": {
        "pre_tags": ["<span class='searchMatchExcerpt'>"],
        "post_tags": ["</span>"]
      },
      "content-*": {
        "pre_tags": ["<span class='searchMatchExcerpt'>"],
        "post_tags": ["</span>"]
      }
    }
  }
}
