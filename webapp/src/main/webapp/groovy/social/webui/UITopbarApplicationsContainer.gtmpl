<%
  import java.util.Locale;

  import io.meeds.portal.navigation.constant.TopbarItemType;
  import io.meeds.portal.navigation.model.TopbarConfiguration;
  import io.meeds.portal.navigation.service.NavigationConfigurationService;
  import io.meeds.social.util.JsonUtils;

  import org.exoplatform.portal.webui.workspace.UIPortalApplication;
  import org.exoplatform.commons.utils.HTMLEntityEncoder;

  def rcontext = _ctx.getRequestContext();
  UIPortalApplication uiPortalApp = rcontext.getUIApplication();

  if (!uicomponent.hasPermission()) {
    return;
  }

  String cssStyle = "";
  String uiComponentWidth = uicomponent.getWidth();
  String uiComponentHeight = uicomponent.getHeight();
  if(uiComponentWidth != null || uiComponentHeight != null) cssStyle = "style=\"";
  if(uiComponentWidth != null) cssStyle += "width: "+uiComponentWidth+";"
  if(uiComponentHeight != null) cssStyle += "height: "+uiComponentHeight+";"
  if(cssStyle.length() > 0) cssStyle += "\"";

  String uiComponentClass = uicomponent.getCssClass() == null ? "" : uicomponent.getCssClass();

  /** Trim the prefix UIContainer- if any, this hardcoded part is needed to update nested container via Ajax */
  String componentId = uicomponent.getId();
  if(componentId.startsWith("UIContainer-")) {
    uicomponent.setId(componentId.substring("UIContainer-".length()));
  }

  NavigationConfigurationService navigationConfigurationService = uicomponent.getApplicationComponent(NavigationConfigurationService.class);
  TopbarConfiguration topbarConfiguration = navigationConfigurationService.getConfiguration().getTopbar();%>
<div class="UIContainer <%=uiComponentClass%> <%=uicomponent.getName()%>" id="${uicomponent.id}" ${cssStyle}>
  <div class="NormalContainerBlock UIComponentBlock">
    <div class="VIEW-CONTAINER VIEW-BLOCK">
      <div class="VuetifyApp UIIntermediateContainer">
        <div id="${uicomponent.id}Children" class="UIRowContainer v-application">
        <%
          for (application in topbarConfiguration.getApplications()) {
            if (application.isEnabled() || application.getId().contains("mandatory-")) {
              if (application.getType() == TopbarItemType.APP) {
                def child = uicomponent.getChildById(application.getId());
                if (child != null && child.isRendered()) {
                  %>
            <div class="<%=application.isMobile() ? "ms-2" : "ms-2 hidden-xs-only"%>">
                  <% child.processRender(rcontext);%>
            </div>
                  <%
                }
              } else if (application.getType() == TopbarItemType.EXTENSION) {
                %>
            <div class="<%=application.isMobile() ? "ms-2" : "ms-2 hidden-xs-only"%>">
              <div
                data-app="true"
                class="v-application v-application--is-ltr theme--light"
                id="<%=application.getId()%>">
                <div class="v-application--wrap">
                  <a class="v-btn v-btn--flat v-btn--icon v-btn--round theme--light v-size--default"
                    rel="nofollow noreferrer noopener">
                    <span class="v-btn__content">
                      <div
                        class="v-card v-card--flat v-sheet theme--light transparent"
                        style="height: 20px; width: 20px;">
                      </div>
                    </span>
                  </a>
                </div>
              </div>
              <script type="text/javascript">
                window.require(["<%=application.getProperties().get("jsModule")%>"], app => app.init("<%=application.getId()%>", <%=JsonUtils.toJsonString(application)%>));
              </script>
            </div>
                <%
              }
            }
          }
        %>
        </div>
      </div>
    </div>
  </div>
</div>